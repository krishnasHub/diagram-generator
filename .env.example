# ── LLM Provider ──────────────────────────────────────────────────────────────
# The server auto-detects whichever key is present (gemini → anthropic → groq → bedrock).
# Set LLM_PROVIDER explicitly to force a specific one.
# LLM_PROVIDER=gemini

# Option 1 — Google Gemini (FREE tier: 15 req/min, 1M tokens/day)
# Get key at: https://aistudio.google.com  (sign in with Google, click "Get API key")
GEMINI_API_KEY=your_gemini_key_here

# Option 2 — Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# Option 3 — Groq (FREE tier, fast Llama models)
# Get key at: https://console.groq.com
# GROQ_API_KEY=gsk_...

# Option 4 — AWS Bedrock
# USE_BEDROCK=true
# AWS_REGION=us-east-1
